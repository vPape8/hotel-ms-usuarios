# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Pega aquí el Tenant ID del directorio de Microsoft Entra ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Pega aquí el Client ID de la aplicación registrada como hotel-bff-admin.
ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000

# Configuración de MySQL local.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hotel
MYSQL_CONNECTION_LIMIT=10

# Configuración de AWS Cognito para huéspedes.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=tu-client-id-de-cognito
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx